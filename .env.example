# Public client configuration only. Never put secret or service-role keys here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional. Blank uses OpenFreeMap (https://openfreemap.org). A custom style
# must come with the attribution its provider's terms require.
MAP_STYLE_URL=
MAP_ATTRIBUTION=

# Optional "latitude,longitude" where Explore opens before the user shares a
# location, e.g. the pilot area. Blank opens the map zoomed out.
EXPLORE_DEFAULT_CENTER=
